# Supabase — Project Settings → API (or Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=
# Legacy JWT anon key, OR new publishable key (sb_publishable_...):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias (optional): same value as anon if you prefer the new env name from Supabase docs
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site origin for OAuth redirects (no trailing slash). Use your Vercel preview URL for Preview deployments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: skip all Supabase in the app (demo UI / broken-env escape hatch)
# RUNFOLIO_OFFLINE_DEMO=1

# Optional: cap for middleware + server auth calls (ms), default 3000
# RUNFOLIO_AUTH_TIMEOUT_MS=5000

# Strava OAuth — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/oauth/callback

# STRAVA_ACCESS_TOKEN=
# STRAVA_REFRESH_TOKEN=

# --- Race ingestion (multi-provider aggregation) ---
# Optional: protect POST /api/races/ingest/import with a shared secret header:
#   x-runfolio-ingest-secret: <same value>
# RACES_INGEST_SECRET=

# Supabase service role — required only for persisting imports to `race_catalog_imports` (server-only; never expose to client).
# SUPABASE_SERVICE_ROLE_KEY=

# ACTIVE / Active.com style API (TODO: confirm official env names + base URL with provider docs)
# RACES_ACTIVE_API_KEY=
# RACES_ACTIVE_BASE_URL=

# ChronoTrack partner API
# RACES_CHRONOTRACK_API_KEY=
# RACES_CHRONOTRACK_BASE_URL=

# Race Result / branding metadata API
# RACES_RACERESULT_API_KEY=
# RACES_RACERESULT_BASE_URL=

# UTMB catalog adapter uses built-in `discoverRaces` — no API key.

# RunSignup — use classic key+secret OR RSU v2 (not both required; pick one pair)
# RACES_RUNSIGNUP_API_KEY=
# RACES_RUNSIGNUP_API_SECRET=
# RACES_RUNSIGNUP_RSU_API_KEY=
# RACES_RUNSIGNUP_RSU_SECRET=
# RACES_RUNSIGNUP_BASE_URL=https://api.runsignup.com/rest

# Mock provider for ingest tests + Find a Race “registries” strip (also registers server-side when set)
# RACES_MOCK_PROVIDER=1
# NEXT_PUBLIC_RACES_INGEST_MOCK=1
